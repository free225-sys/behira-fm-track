# false pour la démo autonome ; true en préproduction/production Supabase.
NEXT_PUBLIC_USE_SUPABASE=false

# true conserve les personas fictifs pendant la recette ; false en production.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true

# Variables publiques du navigateur, fournies par l'environnement de déploiement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Réservée aux scripts d'administration/CI. Jamais dans le bundle frontend.
SUPABASE_SERVICE_ROLE_KEY=
